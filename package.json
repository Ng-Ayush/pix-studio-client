{
  "name": "pix-studio-pro",
  "version": "0.0.0",
  "main": "app.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "npx concurrently \"cd pix-studio-pro && npm start\" \"wait-on http://localhost:4200 && electron .\"",
    "build": "electron-builder",
    "ng": "npx ng s",
    "serve": "cd pix-studio-pro && ng serve",
    "build:angular": "cd pix-studio-pro && ng build",
    "watch": "cd pix-studio-pro && ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:pix-studio-pro": "node dist/pix-studio-pro/server/server.mjs",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:4200 && electron .\"",
    "electron-build": "ng build && electron . && cd.. && cd pix-studio-pro-backend && node server.js",
    "electron:serve": "electron .",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build-dev": "ng build --configuration=dev",
    "build-prod": "ng build --configuration=prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/fire": "^17.1.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/service-worker": "^17.3.12",
    "@angular/ssr": "^17.3.12",
    "@tailwindcss/postcss": "^4.1.4",
    "apexcharts": "^4.7.0",
    "browser-image-compression": "^2.0.2",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "electron-packager": "^17.1.2",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^4.18.2",
    "face-api.js": "^0.22.2",
    "firebase": "^11.10.0",
    "html2canvas-pro": "^1.5.11",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "ng-apexcharts": "^1.16.0",
    "ngx-image-compress": "^18.1.5",
    "ngx-qrcode": "^0.1.0-rc.1",
    "ngx-toastr": "^19.0.0",
    "postcss": "^8.5.3",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.12",
    "@angular/cli": "^17.3.12",
    "@angular/compiler-cli": "^17.3.0",
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^18.18.0",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2",
    "wait-on": "^7.2.0"
  }
}
